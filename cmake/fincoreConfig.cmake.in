@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT TARGET DataFrame::DataFrame)
    find_dependency(DataFrame CONFIG REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/fincoreTargets.cmake")

foreach(_fincore_requested_component IN LISTS fincore_FIND_COMPONENTS)
    set(fincore_${_fincore_requested_component}_FOUND FALSE)

    if(_fincore_requested_component STREQUAL "core" OR
       _fincore_requested_component STREQUAL "fincore")
        set(fincore_${_fincore_requested_component}_FOUND TRUE)
    elseif(_fincore_requested_component STREQUAL "implot" AND
       EXISTS "${CMAKE_CURRENT_LIST_DIR}/fincoreImPlotTargets.cmake")
        if(NOT TARGET fincore::implot)
            include("${CMAKE_CURRENT_LIST_DIR}/fincoreImPlotTargets.cmake")
        endif()
        set(fincore_implot_FOUND TRUE)
    endif()

    if(fincore_FIND_REQUIRED_${_fincore_requested_component} AND
       NOT fincore_${_fincore_requested_component}_FOUND)
        set(fincore_FOUND FALSE)
        set(fincore_NOT_FOUND_MESSAGE
            "Required fincore component '${_fincore_requested_component}' is not installed")
        return()
    endif()
endforeach()
