PROJECT_NAME           = "fincore_cpp"
PROJECT_BRIEF          = "Native C++ portfolio, factor and risk analytics"
PROJECT_NUMBER         = "0.1.0"
OUTPUT_DIRECTORY       = ../_build/doxygen
INPUT                  = ../../include/fincore
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE                = ../../include/fincore/detail
EXCLUDE_SYMBOLS        = fincore::detail::*
EXCLUDE_PATTERNS       = */detail/* */third_party/*
GENERATE_HTML          = NO
GENERATE_LATEX         = NO
GENERATE_XML           = YES
XML_OUTPUT             = xml
XML_PROGRAMLISTING     = YES
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_LOGFILE           = ../_build/doxygen/doxygen-warnings.log
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
HIDE_UNDOC_MEMBERS     = NO
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MARKDOWN_SUPPORT       = YES
# Keep generated prose free of implicit cross-reference nodes: gettext
# translations cannot carry them, which makes bilingual builds inconsistent.
AUTOLINK_SUPPORT       = NO
BUILTIN_STL_SUPPORT    = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SEARCHENGINE           = NO
GENERATE_TREEVIEW      = NO
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = ../../
CASE_SENSE_NAMES       = YES
