msgid "Returns the square root of value, or default_value when value is negative."
msgstr "返回 value 的平方根；当 value 为负时返回 default_value。"

#: ../../site/api/core.md:154
msgid "Returns the simulation operations in source order."
msgstr "按源顺序返回模拟操作。"

