msgstr "结果为 max_attempts - attempt，并截断为零。"

#: ../../site/api/core.md:40
msgid "Connect timeout; defaults to 10.0."
msgstr "连接超时；默认为 10.0。"

#: ../../site/api/core.md:40
msgid "Read timeout; defaults to 30.0."
msgstr "读取超时；默认为 30.0。"

#: ../../site/api/core.md:40
msgid "Total timeout; defaults to 60.0."
msgstr "总超时；默认为 60.0。"

#: ../../site/api/core.md:40
