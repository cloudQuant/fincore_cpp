msgstr "与固定版本 Python ResearchEvaluationSpec 的字段集合对应，包含原生的 UTC 纳秒窗口端点。"

#: ../../site/api/factor.md:283
msgid "Target assets; non-empty and duplicate-free."
msgstr "目标资产；非空且无重复。"

#: ../../site/api/factor.md:283
msgid "Inclusive window start; must not exceed end."
msgstr "闭区间窗口起点；不得晚于 end。"

#: ../../site/api/factor.md:283
msgid "Inclusive window end."
msgstr "闭区间窗口终点。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Provenance snapshot identifier."
msgstr "来源快照标识符。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Provenance price basis."
msgstr "来源价格基准。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Provenance calendar identifier."
msgstr "来源日历标识符。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Provenance data frequency."
msgstr "来源数据频率。"

#: ../../site/api/factor.md:283
msgid "Descriptive source timezone; timestamps remain UTC."
msgstr "描述性的源时区；时间戳仍以 UTC 存储。"

#: ../../site/api/factor.md:283
msgid "Descriptive feed timestamp convention."
msgstr "描述性的推送时间戳约定。"

#: ../../site/api/factor.md:283
msgid "Non-empty, positive, unique price-row horizons."
msgstr "非空、为正且唯一的价行预测期。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Forward-return basis."
msgstr "前瞻收益基准。"

#: ../../site/api/factor.md:283
msgid "Precomputed-label entry convention."
msgstr "预计算标签的入场约定。"

#: ../../site/api/factor.md:283
msgid "Quantile bucket count; normalization requires at least one."
msgstr "分位桶数量；归一化要求至少一个。"

#: ../../site/api/factor.md:283
msgid "Minimum asset count threshold."
msgstr "最少资产数阈值。"

#: ../../site/api/factor.md:283
msgid "Minimum observations per quantile."
msgstr "每个分位的最少观测数。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Cross-sectional preprocessing method."
msgstr "截面预处理方法。"

#: ../../site/api/factor.md:283
msgid "Tolerated data-loss fraction in [0, 1]."
msgstr "可容忍的数据损失比例，位于 [0, 1]。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Positive rank-autocorrelation lags."
msgstr "为正的秩自相关滞后阶。"

#: ../../site/api/factor.md:283
msgid "Per-asset signs; values must be +1 or -1."
msgstr "逐资产符号；取值必须为 +1 或 -1。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Weighted factor blends."
msgstr "加权因子混合。"

#: ../../site/api/factor.md:283
msgid "Named factor pairs; sides distinct."
msgstr "命名的因子对；两侧必须不同。"

#: ../../site/api/factor.md:283 ../../site/api/factor.md:304
msgid "Named provenance ranges."
msgstr "命名的来源区间。"

#: ../../site/api/factor.md:286
msgid "Files written by export_factor_research()."
msgstr "export_factor_research() 写入的文件。"

#: ../../site/api/factor.md:286
msgid "Requested output directory as supplied."
msgstr "按传入原样记录的请求输出目录。"

#: ../../site/api/factor.md:286
