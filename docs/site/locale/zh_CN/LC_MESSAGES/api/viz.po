msgid "Missing values print nan, matching the Python oracle."
msgstr "缺失值打印为 nan，与 Python oracle 一致。"

#: ../../site/api/viz.md:10
msgid "Appends metric cards using each metric's key in input order."
msgstr "按输入顺序使用每个指标的键追加指标卡片。"

#: ../../site/api/viz.md:10
msgid "Appends metric cards for keys in the requested order."
msgstr "按请求顺序为各键追加指标卡片。"

#: ../../site/api/viz.md:10
msgid "Missing or non-finite values render as N/A."
msgstr "缺失或非有限值呈现为 N/A。"

#: ../../site/api/viz.md:10
msgid "Appends raw HTML without escaping."
msgstr "追加未经转义的原始 HTML。"

