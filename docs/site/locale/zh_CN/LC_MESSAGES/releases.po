msgid "Current value"
msgstr "当前值"

#: ../../site/releases.md
msgid "Native library"
msgstr "原生库"

#: ../../site/releases.md
msgid "`include/fincore/version.hpp` (`version_major`/`minor`/`patch`)"
msgstr "`include/fincore/version.hpp`（`version_major`/`minor`/`patch`）"

#: ../../site/releases.md
msgid "`0.1.0`"
msgstr "`0.1.0`"

#: ../../site/releases.md
msgid "Python reference pin"
msgstr "Python 参考固定版本"

#: ../../site/releases.md
msgid "`include/fincore/version.hpp` (`pinned_version_*`)"
msgstr "`include/fincore/version.hpp`（`pinned_version_*`）"

#: ../../site/releases.md
